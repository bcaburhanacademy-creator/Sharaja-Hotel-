rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'bcaburhanacademy@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Menu Items: Publicly readable; Admin writable
    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders: Anyone can create an order with valid fields; only Admin can list, read details, update status, delete
    match /orders/{orderId} {
      allow create: if incoming().orderNumber is string
        && incoming().orderNumber.size() > 0
        && incoming().orderNumber.size() <= 32
        && incoming().customerName is string
        && incoming().customerName.size() > 0
        && incoming().customerName.size() <= 100
        && incoming().phone is string
        && incoming().phone.size() > 0
        && incoming().phone.size() <= 30
        && incoming().items is list
        && incoming().items.size() > 0
        && incoming().items.size() <= 100
        && incoming().total is number
        && incoming().total >= 0
        && incoming().status in ['Pending', 'Preparing', 'Ready', 'Completed', 'Cancelled'];

      allow read, list, update, delete: if isAdmin();
    }

    // Settings: Public read; Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry: Only admins can read/write
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
